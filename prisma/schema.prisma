// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum PlaylistVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model SeichiMapIdentityRegistry {
  key        String   @id @db.VarChar(32)
  identities Json
  version    Int
  updatedAt  DateTime @updatedAt
  updatedBy  String   @db.VarChar(255)
}

model SeichiMapVisited {
  /// レコードの一意識別子
  id           String   @id
  /// ユーザーの識別子
  userId       String
  /// 訪問先の名称
  locationName String
  /// 訪問日時
  visitedAt    DateTime
  /// メモやコメント
  note         String?
  /// 最終更新日時
  updatedAt    DateTime
  /// URL
  url          String?
  /// 外部ロケーション識別子
  locationId   String?

  @@index([userId, visitedAt], map: "SeichiMapVisited_user_visited_idx")
  @@index([locationId, userId], map: "SeichiMapVisited_location_visitor_idx")
}

model SeichiMapShare {
  /// 共有レコードの一意識別子
  shareId   String   @id
  /// ユーザーの識別子
  userId    String
  /// 共有時のニックネーム
  nickname  String
  /// 共有作成日時
  createdAt DateTime
  /// 共有更新日時
  updatedAt DateTime
}

model SeichiMapProfile {
  /// ユーザーの識別子
  userId                String   @id @db.VarChar(255)
  /// 聖地マップで使用するニックネーム
  nickname              String   @db.VarChar(40)
  /// ランキングにニックネームを表示するか
  showNicknameInRanking Boolean  @default(true)
  /// プロフィール作成日時
  createdAt             DateTime @default(now())
  /// プロフィール更新日時
  updatedAt             DateTime @updatedAt
}

enum SeichiMapAchievementMetric {
  LOCATION_COUNT
  PREFECTURE_COUNT
}

enum SeichiMapAchievementThresholdType {
  COUNT
  PERCENT
}

enum SeichiMapAchievementSource {
  LIVE
  BACKFILL
}

enum SeichiMapAchievementRarity {
  N
  R
  SR
  SSR
  UR
}

enum SeichiMapLocationRegion {
  DOMESTIC
  OVERSEAS
  UNKNOWN
}

/// 聖地マップのバッジのマスタ。
model SeichiMapAchievement {
  id                  String                     @id @db.VarChar(64)
  sortOrder           Int
  nameJa              String                     @db.VarChar(100)
  nameEn              String?                    @db.VarChar(100)
  descriptionJa       String?                    @db.VarChar(500)
  descriptionEn       String?                    @db.VarChar(500)
  metric              SeichiMapAchievementMetric @default(LOCATION_COUNT)
  /// 対象地点のルール配列。配列内はOR、各ルール内の条件はAND。空配列は全地点。
  criteria            Json
  /// 都道府県×47のように分母を固定する場合に設定する。
  denominatorOverride Int?
  isActive            Boolean                    @default(true)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  tiers               SeichiMapAchievementTier[]

  @@index([isActive, sortOrder], map: "SeichiMapAchievement_active_sort_idx")
}

/// バッジのグレード。PERCENTは10〜100で、100は全制覇。
model SeichiMapAchievementTier {
  achievementId  String                            @db.VarChar(64)
  level          Int
  thresholdType  SeichiMapAchievementThresholdType
  thresholdValue Int
  rarity         SeichiMapAchievementRarity        @default(N)
  achievement    SeichiMapAchievement              @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([achievementId, level])
}

/// 自動判定の例外。通常は空。
model SeichiMapAchievementLocationOverride {
  achievementId String  @db.VarChar(64)
  locationId    String  @db.VarChar(16)
  /// true は対象に含め、false は対象から外す。
  include       Boolean
  note          String? @db.VarChar(255)

  @@id([achievementId, locationId])
}

/// バッジ判定に使う地点のスナップショット。KML同期時に置き換える。
model SeichiMapLocationSnapshot {
  locationId     String                  @id @db.VarChar(16)
  folder         String                  @db.VarChar(255)
  name           String                  @db.VarChar(500)
  latitude       Float
  longitude      Float
  region         SeichiMapLocationRegion @default(UNKNOWN)
  /// JISの都道府県コード（01〜47）。
  prefectureCode String?                 @db.Char(2)
  geocodedAt     DateTime?
  syncedAt       DateTime
}

model SeichiMapAchievementSyncState {
  key           String    @id @db.VarChar(32)
  version       Int
  kmlHash       String    @db.Char(64)
  locationCount Int
  syncedAt      DateTime
  syncedBy      String    @db.VarChar(255)
  /// 同期処理の実行中を示すリース。期限を過ぎたら別の処理が取得できる。
  lockedUntil   DateTime?
}

/// ユーザーが表示用に選んだ称号。未設定なら最もレア度の高いグレードを表示する。
model SeichiMapUserTitle {
  userId        String   @id @db.VarChar(255)
  achievementId String   @db.VarChar(64)
  level         Int
  updatedAt     DateTime @updatedAt
}

/// ユーザーごとの達成状況。一度付与したグレードは削除しない。
model SeichiMapUserAchievement {
  userId             String                     @db.VarChar(255)
  achievementId      String                     @db.VarChar(64)
  level              Int
  achievedAt         DateTime                   @default(now())
  source             SeichiMapAchievementSource
  progressCount      Int
  denominatorAtAward Int?
  seenAt             DateTime?

  @@id([userId, achievementId, level])
  @@index([userId, seenAt], map: "SeichiMapUserAchievement_user_seen_idx")
  @@index([achievementId, level], map: "SeichiMapUserAchievement_tier_idx")
}

model Statistics {
  id           String   @id @default(uuid()) @db.Char(36)
  videoId      String?  @map("video_id") @db.VarChar(50)
  datetime     DateTime
  title        String?  @db.VarChar(255)
  category     String?  @db.VarChar(50)
  viewCount    Int?     @map("view_count")
  likeCount    Int?     @map("like_count")
  commentCount Int?     @map("comment_count")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([videoId, datetime])
  @@index([category, datetime, videoId], map: "Statistics_category_datetime_video_idx")
  @@map("statistics")
}

model ChannelSubscriberHistory {
  channelId       String   @map("channel_id") @db.VarChar(64)
  snapshotDate    DateTime @map("snapshot_date") @db.Date
  subscriberCount BigInt   @map("subscriber_count") @db.UnsignedBigInt
  observedAtUtc   DateTime @map("observed_at_utc") @db.DateTime(3)
  channelName     String   @map("channel_name") @db.VarChar(255)

  @@id([channelId, snapshotDate])
  @@index([snapshotDate], map: "ChannelSubscriberHistory_snapshot_date_idx")
  @@map("channel_subscriber_history")
}

model UserPlaylist {
  id         String                 @id @default(uuid()) @db.Char(36)
  userId     String                 @db.VarChar(255)
  name       String                 @db.VarChar(200)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  visibility PlaylistVisibility     @default(PRIVATE)
  entries    UserPlaylistEntry[]
  imports    LegacyPlaylistImport[]

  @@unique([userId, name], map: "UserPlaylist_user_name_key")
  @@index([userId, updatedAt], map: "UserPlaylist_user_updated_idx")
}

model UserPlaylistEntry {
  id         String       @id @default(uuid()) @db.Char(36)
  playlistId String       @db.Char(36)
  videoId    String       @db.VarChar(100)
  start      String       @db.VarChar(32)
  position   Int
  playlist   UserPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId, start], map: "UserPlaylistEntry_song_key")
  @@unique([playlistId, position], map: "UserPlaylistEntry_position_key")
}

model UserFavorite {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.VarChar(255)
  videoId   String   @db.VarChar(100)
  start     String   @db.VarChar(32)
  position  Int
  createdAt DateTime @default(now())

  @@unique([userId, videoId, start], map: "UserFavorite_song_key")
  @@unique([userId, position], map: "UserFavorite_position_key")
}

model LegacyPlaylistImport {
  id          String        @id @default(uuid()) @db.Char(36)
  userId      String        @db.VarChar(255)
  fingerprint String        @db.Char(64)
  playlistId  String?       @db.Char(36)
  importedAt  DateTime      @default(now())
  playlist    UserPlaylist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  @@unique([userId, fingerprint], map: "LegacyPlaylistImport_user_fingerprint_key")
  @@index([playlistId], map: "LegacyPlaylistImport_playlist_idx")
}

model BestNineTopic {
  id             String                  @id @default(uuid()) @db.Char(36)
  ownerId        String                  @db.VarChar(255)
  currentVersion Int                     @default(1)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  revisions      BestNineTopicRevision[]

  @@index([ownerId, updatedAt])
}

/// 公開済みのお題は変更せず、編集のたびに改訂を追加する。
model BestNineTopicRevision {
  id             String             @id @default(uuid()) @db.Char(36)
  topicId        String             @db.Char(36)
  version        Int
  title          String             @db.VarChar(50)
  themes         Json
  /// NULL は従来のお題（全カテゴリ）。
  slotCategories Json?
  songCount      Int                @default(9)
  allowedLiveIds Json?
  hashtags       Json?
  createdAt      DateTime           @default(now())
  topic          BestNineTopic      @relation(fields: [topicId], references: [id], onDelete: Restrict)
  responses      BestNineResponse[]

  @@unique([topicId, version])
}

model BestNineResponse {
  id            String                  @id @db.VarChar(20)
  revisionId    String?                 @db.Char(36)
  /// アカウントIDとゲストCookieは異なる名前空間でHMAC化する。
  respondentKey String                  @db.Char(64)
  /// Googleログイン時のみ設定。ゲスト用の架空ユーザーは作らない。
  userId        String?                 @db.VarChar(255)
  selection     Json
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  revision      BestNineTopicRevision?  @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  entries       BestNineResponseEntry[]

  @@unique([revisionId, respondentKey])
  @@index([revisionId, userId])
}

model BestNineResponseEntry {
  responseId     String           @db.VarChar(20)
  slot           Int
  sourceType     String           @default("video") @db.VarChar(10)
  liveId         String?          @db.VarChar(200)
  liveEntryKey   String?          @db.Text
  livePath       String?          @db.VarChar(1000)
  singers        String?          @db.VarChar(500)
  videoId        String?          @db.VarChar(100)
  start          String?          @db.VarChar(32)
  /// 集計用の曲名・歌手はサーバーで取得した日本語の原表記を保存する。
  songKey        String           @db.Char(64)
  /// MySQLの照合順序に依存せず、動画IDの大文字・小文字を区別する。
  performanceKey String           @db.Char(64)
  videoTitle     String           @db.VarChar(500)
  broadcastAt    String           @db.VarChar(64)
  title          String           @db.VarChar(500)
  artist         String           @db.VarChar(500)
  response       BestNineResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@id([responseId, slot])
  @@index([songKey])
}
